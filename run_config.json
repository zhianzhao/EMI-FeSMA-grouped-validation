        2,
        4,
        6
      ],
      "evaluated_dates": [
        23,
        28,
        34,
        43,
        53,
        67
      ],
      "outer": "expanding-window rolling origin",
      "inner": "rolling-origin splits within each outer training period",
      "split_seed": null
    },
    "loading_to_failure": {
      "group": "specimen-stage",
      "outer": "4-fold randomized grouped",
      "inner": "3-fold grouped",
      "outer_seed": 42,
      "inner_seed": 59
    }
  },
  "supplementary_files": {
